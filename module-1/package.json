{
    "name": "module-1",
    "version": "1.0.0",
    "private": true,
    "license": "UNLICENSED",
    "description": "A set of code examples & exercises for module #1.",
    "repository": "https://github.com/Institution-for-a-Global-Society/blockchain-lecture-series.git",
    "homepage": "https://github.com/Institution-for-a-Global-Society/blockchain-lecture-series.git#readme",
    "packageManager": "yarn@4.7.0",
    "scripts": {
        "dev": "anvil",
        "compile": "forge b --via-ir --optimize --sizes",
        "clean": "forge clean",
        "lint": "yarn run -T solhint --fix 'contracts/*.sol'",
        "lint:dry-run": "yarn run -T solhint 'contracts/*.sol'",
        "format-sol": "yarn run -T prettier -w --plugin=prettier-plugin-solidity 'contracts/*'",
        "format-sol:dry-run": "yarn run -T prettier -c --plugin=prettier-plugin-solidity 'contracts/*'",
        "format-misc": "yarn run -T prettier -w '**/*.ts' '**/*.md' '**/*.json'",
        "format-misc:dry-run": "yarn run -T prettier -c '**/*.ts' '**/*.md' '**/*.json'",
        "deploy-status": "yarn run -T hardhat ignition status chain-31337",
        "deploy:greeting": "yarn run -T hardhat ignition deploy --network localhost ./ignition/modules/Greeting.ts",
        "run:greeting": "yarn run -T hardhat run --network localhost ./scripts/Greeting.ts"
    }
}
